#!/usr/bin/env bash
# gh extension entry point. Repo must be named gh-pr-tools; gh execs this file
# and forwards all arguments when you run `gh pr-tools ...`.
set -euo pipefail

dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
usage: gh pr-tools [--profile NAME|-p NAME] <command> [args]

commands:
  init                              create or update a profile (repo/org/Jira)
  profile list                      list all profiles ((cwd) marks a checkout match)
  profile show [name]               print a profile's settings (default: currently resolved)
  profile set <key> [value]         change one setting on the resolved profile
                                    (omit value to be prompted; --profile picks another)
  profile unset <key>               drop one setting, reverting it to its default
  profile remove <name>             delete a profile
  prd [--watch[=INTERVAL]] <pr|TICKET-123|link|branch>
                                    show a PR's approvers and pending reviewers
  todo [--long] [--short-links] [--short-labels] [--include-drafts] [--watch[=INTERVAL]]
                                    list open PRs you're a reviewer on (--watch default: 5m)
  mine [--long] [--short-links] [--short-labels] [--include-drafts] [--include-assigned] [--watch[=INTERVAL]]
                                    list your own open PRs; --include-assigned adds ones assigned to you (--watch default: 5m)
  track [--long] [--short-links] [--short-labels] [--limit N] [--list FILE] [--watch[=INTERVAL]] [PR...]
                                    the repo's open PRs incl. drafts (oldest --limit, default 50), or
                                    just the ones you name by number or GitHub PR link (any state);
                                    --list reads them from a file, re-read each refresh (--watch default: 5m)
  stale-branches [--limit N] [--author LOGIN|--all]
                                    closed PRs whose head branch still exists (default: your own; --author for someone else's, --all for the whole repo)
  notify <pr|TICKET-123|link|branch>  poll a PR's CI every 5s, macOS notify when done
  tg add <login> <handle>           map a GitHub login to a Telegram handle
  tg remove <login>
  tg list
  tg import [file]                  bulk add from "login handle"/"login,handle" lines (or stdin)
  tg import --json [file]           bulk add from a {"login": "handle"} JSON file (or stdin)
  clear [-y|--yes]                  remove all config created by init/tg (prompts unless -y)

Profile resolution (for prd/todo/mine/track/stale-branches): --profile, else match by repo inside a git checkout (must be in git; run init if unmatched).
Telegram map is shared across profiles.
Team rosters are cached locally for 1h (affects the APPROVALS team split and todo's team-requested PRs).
Set GH_PR_TOOLS_TEAM_CACHE to another duration (30m, 1h30m) or 0 to bypass — in the environment, or in a profile.
THREAD_WATCH_USERS (in a profile, or GH_PR_TOOLS_THREAD_WATCH_USERS in the environment) is a comma-separated
list of logins; each gets its own review-thread column in todo/mine/track, and its threads leave the THREADS column.
--short-labels (-S) shortens the review-thread state words in those columns: "6 (2 pending, 1 answered, 3 resolved)" becomes "6 (2P 1A 3R)".
--include-drafts (-d) adds draft PRs to todo/mine, which leave them out by default; their STATUS reads "Draft".
EOF
}

# Strip global --profile / -p before the subcommand.
GH_PR_TOOLS_PROFILE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --profile|-p)
      [ $# -ge 2 ] || { echo "gh pr-tools: $1 requires a profile name" >&2; exit 1; }
      GH_PR_TOOLS_PROFILE="$2"
      shift 2
      ;;
    --profile=*|-p=*)
      GH_PR_TOOLS_PROFILE="${1#*=}"
      shift
      ;;
    *)
      break
      ;;
  esac
done
export GH_PR_TOOLS_PROFILE

cmd="${1:-}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
  init)               exec "$dir/lib/init.sh" "$@" ;;
  profile)            exec "$dir/lib/profile.sh" "$@" ;;
  prd)                exec "$dir/lib/prd.sh" "$@" ;;
  todo)               exec "$dir/lib/todo.sh" "$@" ;;
  mine)               exec "$dir/lib/mine.sh" "$@" ;;
  track)              exec "$dir/lib/track.sh" "$@" ;;
  stale-branches)     exec "$dir/lib/stale-branches.sh" "$@" ;;
  notify)             exec "$dir/lib/notify.sh" "$@" ;;
  tg)                 exec "$dir/lib/tg.sh" "$@" ;;
  clear)              exec "$dir/lib/clear.sh" "$@" ;;
  ""|help|-h|--help)  usage ;;
  *)
    echo "gh pr-tools: unknown command '$cmd'" >&2
    usage
    exit 1
    ;;
esac
